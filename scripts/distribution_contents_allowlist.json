{
  "schema_version": 1,
  "wheel": {
    "allowed": [
      "bayesrisk/*.py",
      "bayesrisk/_build_manifest.json",
      "bayesrisk/**/*.py",
      "bayesrisk/py.typed",
      "bayesrisk/report/templates/*.j2",
      "bayesrisk/report/templates/*.css",
      "bayesrisk/report/templates/fonts/*.woff2",
      "bayesrisk/report/templates/fonts/*.txt",
      "bayesrisk/provisioning/cmf/data/*.yaml",
      "bayesrisk/provisioning/cmf/data/*.json",
      "bayesrisk/provisioning/cmf/data/*.sha256",
      "bayesrisk/ui/static/index.html",
      "bayesrisk/ui/static/*.svg",
      "bayesrisk/ui/static/*.txt",
      "bayesrisk/ui/static/assets/*.js",
      "bayesrisk/ui/static/assets/*.css",
      "*.dist-info/METADATA",
      "*.dist-info/WHEEL",
      "*.dist-info/RECORD",
      "*.dist-info/entry_points.txt",
      "*.dist-info/licenses/LICENSE"
    ],
    "required": [
      "bayesrisk/_build_manifest.json",
      "bayesrisk/ui/static/index.html",
      "bayesrisk/ui/static/THIRD_PARTY_NOTICES.frontend.txt",
      "bayesrisk/ui/__main__.py",
      "{dist_info}/entry_points.txt"
    ]
  },
  "sdist": {
    "allowed": [
      ".gitignore",
      "CHANGELOG.md",
      "LICENSE",
      "PKG-INFO",
      "README.md",
      "pyproject.toml",
      "src/bayesrisk/*.py",
      "src/bayesrisk/_build_manifest.json",
      "src/bayesrisk/**/*.py",
      "src/bayesrisk/py.typed",
      "src/bayesrisk/report/templates/*.j2",
      "src/bayesrisk/report/templates/*.css",
      "src/bayesrisk/report/templates/fonts/*.woff2",
      "src/bayesrisk/report/templates/fonts/*.txt",
      "src/bayesrisk/provisioning/cmf/data/*.yaml",
      "src/bayesrisk/provisioning/cmf/data/*.json",
      "src/bayesrisk/provisioning/cmf/data/*.sha256",
      "src/bayesrisk/ui/static/index.html",
      "src/bayesrisk/ui/static/*.svg",
      "src/bayesrisk/ui/static/*.txt",
      "src/bayesrisk/ui/static/assets/*.js",
      "src/bayesrisk/ui/static/assets/*.css",
      "tests/*.py",
      "tests/**/*.py",
      "tests/fixtures/option_effect_oracles.txt",
      "tests/fixtures/option_surface_ledger.json",
      "tests/fixtures/survival_coefficients_f4.json"
    ],
    "required": [
      "src/bayesrisk/_build_manifest.json",
      "PKG-INFO",
      "pyproject.toml",
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "src/bayesrisk/ui/static/index.html",
      "src/bayesrisk/ui/static/THIRD_PARTY_NOTICES.frontend.txt",
      "src/bayesrisk/ui/__main__.py"
    ]
  },
  "forbidden_parts": [
    "web",
    ".vercel",
    "fixtures/demo",
    "BAYESRISK_DEMO_FIXTURE_ONLY",
    "privado",
    "secrets"
  ],
  "forbidden_suffixes": [
    ".csv",
    ".parquet",
    ".xlsx",
    ".xls",
    ".pdf",
    ".docx",
    ".zip"
  ]
}
